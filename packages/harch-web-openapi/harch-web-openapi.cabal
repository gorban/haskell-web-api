cabal-version: 3.14
name: harch-web-openapi
version: 0.1.2.0
synopsis: Optional OpenAPI interpreter support for Harch Web
description:
  Optional OpenAPI data-model support for typed Harch Web API declarations.

homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
license-file: LICENSE
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Web
build-type: Simple
-- Pinned Swagger UI 5.33.0 distribution plus this package's own
-- documentation assets; see assets/swagger-ui/README.md for the pin,
-- license, and CSP rationale. Listed explicitly (not globbed) so a pin
-- update is one reviewed manifest diff.
data-files:
  assets/swagger-ui/LICENSE.apache-2.0
  assets/swagger-ui/NOTICE
  assets/swagger-ui/package.json
  assets/swagger-ui/README.md
  assets/swagger-ui/swagger-enhancement.js
  assets/swagger-ui/swagger-ui-bundle.js
  assets/swagger-ui/swagger-ui.css

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed: True
  exposed-modules:
    HarchWeb.OpenApi
    HarchWeb.OpenApi.Document
    HarchWeb.OpenApi.Metadata
    HarchWeb.OpenApi.Provider
    HarchWeb.OpenApi.Route
    HarchWeb.OpenApi.Security
    HarchWeb.OpenApi.Swagger

  other-modules:
    Paths_harch_web_openapi

  autogen-modules:
    Paths_harch_web_openapi

  hs-source-dirs: src
  build-depends:
    -- The frozen 0.3.0 release has the reviewed stale-Aeson-bound exception;
    -- see cabal.project and tools/test-openapi3-compatibility-stack.sh.
    aeson ^>=2.3.1.0,
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    containers ^>=0.8,
    harch-web ^>=0.1.2.0,
    http-media ^>=0.8.1.1,
    http-types ^>=0.12.5,
    insert-ordered-containers ^>=0.3,
    network-uri ^>=2.6.4.2,
    openapi3 ^>=3.2.5,
    text ^>=2.1.2,

test-suite harch-web-openapi-tests
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  -- hspec-discover imports every test module. Keep this complete and let the
  -- manifest check verify it against test/ rather than suppress Cabal warnings.
  other-modules:
    Unit.HarchWeb.OpenApi.DocumentSpec
    Unit.HarchWeb.OpenApi.MetadataSpec
    Unit.HarchWeb.OpenApi.ProviderSpec
    Unit.HarchWeb.OpenApi.RouteSpec
    Unit.HarchWeb.OpenApi.SecuritySpec
    Unit.HarchWeb.OpenApi.SwaggerUiSpec
    Unit.HarchWeb.OpenApiSpec

  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-tool-depends:
    hspec-discover:hspec-discover ^>=2.11.17,
    test-spec-preprocessor:spec-preprocessor ^>=0.1.2.0,

  main-is: Main.hs
  build-depends:
    aeson ^>=2.3.1.0,
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    containers ^>=0.8,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    harch-web ^>=0.1.2.0,
    harch-web-openapi ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    openapi3 ^>=3.2.5,
    test-core ^>=0.1.2.0,
    text ^>=2.1.2,
    wai ^>=3.2.5,
