cabal-version: 3.14
name: postgres-database-changes
version: 0.1.2.0
synopsis: Immutable ordered PostgreSQL database-change runner
description:
  A PostgreSQL-specific transaction and digest ledger for application-owned
  ordered DDL and DML changes.

homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Database
build-type: Simple

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed: True
  exposed-modules:
    Postgres.DatabaseChange

  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    core ^>=0.1.2.0,
    crypton ^>=1.0.6,
    mtl ^>=2.3.1,
    postgresql-libpq ^>=0.11.0.0,
    text ^>=2.1.3,

  hs-source-dirs: src

test-suite postgres-database-changes-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Unit.Postgres.DatabaseChangeSpec

  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-tool-depends:
    hspec-discover:hspec-discover ^>=2.11.17,
    test-spec-preprocessor:spec-preprocessor ^>=0.1.2.0,

  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    hspec ^>=2.11.17,
    postgres-database-changes ^>=0.1.2.0,
    test-core ^>=0.1.2.0,
    text ^>=2.1.3,
