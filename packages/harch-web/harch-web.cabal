cabal-version: 3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.
-- The name of the package.
name: harch-web
-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version: 0.1.2.0
-- A short (one-line) description of the package.
synopsis: haskell architecture web facade
-- A longer description of the package.
description:
  Minimal facade package for the future SSR-first web framework boundary.

-- URL for the project homepage or repository.
homepage: https://github.com/gorban/haskell-web-api
-- The license under which the package is released.
license: BSD-2-Clause-Patent
license-file: LICENSE
-- The package author(s).
author: David Bruck
-- An email address to which users can send suggestions, bug reports, and patches.
maintainer: 1393236+gorban@users.noreply.github.com
-- A copyright notice.
copyright: (c) David Bruck
category: Web
build-type: Custom
-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files: CHANGELOG.md

custom-setup
  setup-depends:
    base ^>=4.22.0.0,
    Cabal,
    directory,

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:
common common
  -- Common warning flags.
  ghc-options: -Wall
  -- Common settings.
  default-language: GHC2024

library
  import: common
  -- Common library settings.
  exposed: True
  -- Modules included in this library.
  exposed-modules:
    HarchWeb
    HarchWeb.Account
    HarchWeb.Acme
    HarchWeb.Database
    HarchWeb.DevSmtp
    HarchWeb.Document
    HarchWeb.Email
    HarchWeb.Gmail
    HarchWeb.GoogleWorkspace
    HarchWeb.LoginProtection
    HarchWeb.Markup
    HarchWeb.Markup.Unsafe
    HarchWeb.Observability
    HarchWeb.Password
    HarchWeb.RecoveryCode
    HarchWeb.Routing
    HarchWeb.Secret
    HarchWeb.Security
    HarchWeb.Server
    HarchWeb.Session
    HarchWeb.Site
    HarchWeb.StaticAssets
    HarchWeb.Totp
    HarchWeb.Username

  other-modules:
    HarchWeb.Acme.Certbot.Options
    HarchWeb.Acme.Certbot.Runtime
    HarchWeb.Acme.Challenge
    HarchWeb.Acme.Crypto
    HarchWeb.Acme.Json
    HarchWeb.Acme.KeyMaterial
    HarchWeb.Acme.OpenSsl
    HarchWeb.Acme.Protocol.Client
    HarchWeb.Acme.Protocol.Decode
    HarchWeb.Acme.Protocol.Types
    HarchWeb.Acme.Protocol.Workflow
    HarchWeb.Markup.Internal
    HarchWeb.Markup.Quasi
    HarchWeb.Observability.Otlp
    HarchWeb.Observability.Otlp.Export
    HarchWeb.Observability.Otlp.Wire
    HarchWeb.Observability.Types
    HarchWeb.PathPrefix
    HarchWeb.Server.Application
    HarchWeb.Server.ClientAction
    HarchWeb.Server.Config
    HarchWeb.Server.LocalTest
    HarchWeb.Server.RequestExecution
    HarchWeb.Server.Response
    HarchWeb.Server.ResponseRendering
    HarchWeb.Server.Runtime
    HarchWeb.Server.Sse
    HarchWeb.Server.StaticAssets
    HarchWeb.Server.Transport
    HarchWeb.Server.Transport.Tls

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    aeson,
    base ^>=4.22.0.0,
    base64-bytestring,
    bytestring,
    case-insensitive,
    cryptonite,
    directory,
    filepath,
    haskell-src-meta,
    http-client,
    http-client-tls,
    http-types,
    memory,
    mtl,
    network,
    pem,
    process,
    template-haskell,
    temporary,
    text,
    time,
    tls,
    unix,
    wai,
    warp,
    warp-tls,

  -- Directories containing source files.
  hs-source-dirs: src

test-suite harch-web-tests
  import: common
  -- Common test suite settings.
  type: exitcode-stdio-1.0
  -- Directories containing source files.
  hs-source-dirs: test
  ghc-options:
    -Wno-missing-home-modules
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-tool-depends:
    -- Discovers hspec *Spec.hs tests
    hspec-discover:hspec-discover

  -- .hs or .lhs file containing the Main module.
  main-is: Main.hs
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    -- For testing framework:
    aeson,
    asn1-encoding,
    asn1-types,
    base ^>=4.22.0.0,
    base64-bytestring,
    bytestring,
    cryptonite,
    directory,
    filepath,
    harch-web,
    hspec,
    http-client,
    http-types,
    network,
    pem,
    process,
    template-haskell,
    temporary,
    test-core,
    text,
    time,
    tls,
    unix,
    wai,
    warp,
