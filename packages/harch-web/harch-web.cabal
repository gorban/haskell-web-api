  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    aeson ^>=2.3.1.0,
    asn1-encoding ^>=0.9.6,
    asn1-types ^>=0.3.4,
    base ^>=4.22.0.0,
    base16-bytestring ^>=1.0.2.0,
    base64-bytestring ^>=1.2.1.0,
    bytestring ^>=0.12.2.0,
    case-insensitive ^>=1.2.1.0,
    containers ^>=0.8,
    crypton ^>=1.0.6,
    crypton-x509 ^>=1.7.7,
    crypton-x509-system ^>=1.6.8,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    haskell-src-meta ^>=0.8.16,
    http-client ^>=0.7.19,
    http-client-tls ^>=0.3.6.4,
    http-date ^>=0.0.11,
    http-types ^>=0.12.5,
    jose ^>=0.12,
    lens ^>=5.3,
    memory ^>=0.18.0,
    mtl ^>=2.3.1,
    network ^>=3.2.8.0,
