    wai ^>=3.2.5,
    warp ^>=3.4.12,
    warp-tls ^>=3.4.9,

  cxx-sources: cbits/localization.cpp
  extra-libraries:
    icui18n
    icuuc
    stdc++

  -- Directories containing source files.
  hs-source-dirs: src

test-suite harch-web-tests
  import: common
  -- Common test suite settings.
  type: exitcode-stdio-1.0
  -- Directories containing source files.
  hs-source-dirs: test
  -- hspec-discover imports every test module. Keep this complete and let the
  -- manifest check verify it against test/ rather than suppress Cabal's warning.
  other-modules:
    Unit.HarchWeb.AccountSpec
    Unit.HarchWeb.Acme.Certbot.OptionsSpec
    Unit.HarchWeb.Acme.Certbot.RuntimeSpec
    Unit.HarchWeb.Acme.ChallengeSpec
    Unit.HarchWeb.Acme.JsonSpec
    Unit.HarchWeb.AcmeSpec
    Unit.HarchWeb.ActionSpec
    Unit.HarchWeb.Api.EndpointSpec
    Unit.HarchWeb.Api.Multipart.DispositionSpec
    Unit.HarchWeb.Api.Multipart.ScannerSpec
    Unit.HarchWeb.Api.MultipartSpec
    Unit.HarchWeb.Api.NegotiationSpec
    Unit.HarchWeb.Api.RequestSpec
    Unit.HarchWeb.Api.ResponseSpec
    Unit.HarchWeb.ApplicationModuleSpec
    Unit.HarchWeb.Authentication.AttemptSpec
    Unit.HarchWeb.Authentication.JwtSpec
    Unit.HarchWeb.AuthenticationSpec
    Unit.HarchWeb.DatabaseSpec
    Unit.HarchWeb.DevSmtpSpec
    Unit.HarchWeb.DocumentSpec
    Unit.HarchWeb.EmailSpec
    Unit.HarchWeb.EndpointSecuritySpec
