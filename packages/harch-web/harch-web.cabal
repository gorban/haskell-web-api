  import: common
  -- Common library settings.
  exposed: True
  -- Modules included in this library.
  exposed-modules:
    HarchWeb
    HarchWeb.Account
    HarchWeb.Acme
    HarchWeb.Acme.Json
    HarchWeb.Action
    HarchWeb.Api
