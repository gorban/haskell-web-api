    Unit.HarchWeb.Observability.Otlp.TestSupport
    Unit.HarchWeb.Observability.TypesSpec
    Unit.HarchWeb.ObservabilitySpec
    Unit.HarchWeb.PasswordSpec
    Unit.HarchWeb.PathPrefixSpec
    Unit.HarchWeb.RecoveryCodeSpec
    Unit.HarchWeb.RequestContextSpec
    Unit.HarchWeb.RoutingSpec
    Unit.HarchWeb.SecretSpec
    Unit.HarchWeb.Security.ForwardedTrustSpec
    Unit.HarchWeb.Security.RequestLimitsSpec
    Unit.HarchWeb.SecurityEventSpec
    Unit.HarchWeb.SecuritySpec
    Unit.HarchWeb.Server.ApplicationSpec
    Unit.HarchWeb.Server.ConfigSpec
    Unit.HarchWeb.Server.LocalTestSpec
    Unit.HarchWeb.Server.RequestExecutionSpec
    Unit.HarchWeb.Server.RuntimeSpec
    Unit.HarchWeb.Server.SseSpec
    Unit.HarchWeb.Server.Transport.TlsSpec
    Unit.HarchWeb.Server.TransportSpec
    Unit.HarchWeb.SessionSpec
    Unit.HarchWeb.SiteSpec
    Unit.HarchWeb.StaticAssets.RouteSpec
    Unit.HarchWeb.StaticAssetsSpec
    Unit.HarchWeb.TestSupport
    Unit.HarchWeb.TimeSpec
    Unit.HarchWeb.TotpSpec
    Unit.HarchWeb.UsernameSpec

  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-tool-depends:
    -- Discovers hspec *Spec.hs tests
    -- Our spec-preprocessor to fill in {-# SPEC #-} headers
    hspec-discover:hspec-discover ^>=2.11.17,
    test-spec-preprocessor:spec-preprocessor ^>=0.1.2.0,

  -- .hs or .lhs file containing the Main module.
  main-is: Main.hs
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    -- For testing framework:
    aeson ^>=2.3.1.0,
    asn1-encoding ^>=0.9.6,
    asn1-types ^>=0.3.4,
    base ^>=4.22.0.0,
    base64-bytestring ^>=1.2.1.0,
    bytestring ^>=0.12.2.0,
    containers ^>=0.8,
    crypton ^>=1.0.6,
    data-default ^>=0.8.0.2,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-client ^>=0.7.19,
    http-types ^>=0.12.5,
    jose ^>=0.12,
