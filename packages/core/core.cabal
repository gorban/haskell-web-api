cabal-version: 3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.
-- The name of the package.
name: core
-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version: 0.1.2.0
-- A short (one-line) description of the package.
synopsis: haskell core (utilities shared across application and tests)
-- A longer description of the package.
description:
  Shared utility functions and types used by test-core,
  haskell-web-api, and other packages in this repository.

-- URL for the project homepage or repository.
homepage: https://github.com/gorban/haskell-web-api
-- The license under which the package is released.
license: BSD-2-Clause-Patent
license-file: LICENSE
-- The package author(s).
author: David Bruck
-- An email address to which users can send suggestions, bug reports, and patches.
maintainer: 1393236+gorban@users.noreply.github.com
-- A copyright notice.
copyright: (c) David Bruck
category: Web
build-type: Simple
-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files: CHANGELOG.md

common common
  -- Common warning flags.
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wunused-packages

  -- Common settings.
  default-language: GHC2024

library
  import: common
  -- Common library settings.
  exposed: True
  -- Modules included in this library.
  exposed-modules:
    Core.Config
    Core.Control.Error
    Core.PageRoutes.Generator
    Core.Prelude
    Core.Setup.ContainerRuntime
    Core.Setup.DatabaseAutostart
    Core.Setup.Prerequisite
    Core.Setup.PrerequisiteConfig
    Core.Setup.PrerequisitePlan
    Core.Setup.PrerequisiteReport
    Core.Setup.TracingAutostart
    Core.System.Path
    Core.System.Temp

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    base ^>=4.22.0.0,
    containers ^>=0.8,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    mtl ^>=2.3.1,
    network ^>=3.2.8.0,
    process ^>=1.6.26.1,
    temporary ^>=1.3,
    text ^>=2.1.3,

  -- Directories containing source files.
  hs-source-dirs: src

executable harch-page-routes
  import: common
  main-is: PageRoutes.hs
  hs-source-dirs: app
  build-depends:
    base ^>=4.22.0.0,
    core ^>=0.1.2.0,

-- Internal spec-preprocessor that compiles test-core sources directly.
-- This avoids the package-level cycle that would occur if core-tests
-- depended on test-core:spec-preprocessor.
-- Sources are a checked-in test-core snapshot, verified by
-- tools/check-cabal-packages.sh to avoid the package-level dependency cycle.
executable core-spec-preprocessor
  import: common
  main-is: SpecPreprocessor.hs
  -- Modules included in this executable, other than Main.
  other-modules: TestCore.SpecPreprocessor
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  hs-source-dirs:
    test-core-src/app
    test-core-src/src

  build-depends:
    base ^>=4.22.0.0,
    core ^>=0.1.2.0,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    mtl ^>=2.3.1,

test-suite core-tests
  import: common
  -- Common test suite settings.
  type: exitcode-stdio-1.0
  -- Include the checked-in test-core snapshot to get TestCore.Prelude and
  -- TestCore.CustomAssertions without creating a package-level dependency cycle.
  hs-source-dirs:
    test
    test-core-src/src

  ghc-options:
    -F
    -pgmF=core-spec-preprocessor
    -Wno-missing-home-modules
    -rtsopts
    -threaded
    -with-rtsopts=-N
    -- Discovers hspec *Spec.hs tests

  build-tool-depends:
    -- Our internal spec-preprocessor
    core:core-spec-preprocessor ^>=0.1.2.0,
    hspec-discover:hspec-discover ^>=2.11.17,

  -- .hs or .lhs file containing the Main module.
  main-is: Main.hs
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    -- For testing framework:
    base ^>=4.22.0.0,
    core ^>=0.1.2.0,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    hspec ^>=2.11.17,
    hspec-expectations-match ^>=0.2.0.0,
    HUnit ^>=1.6.2.0,
    mtl ^>=2.3.1,
    network ^>=3.2.8.0,
    process ^>=1.6.26.1,
    temporary ^>=1.3,
    text ^>=2.1.3,
