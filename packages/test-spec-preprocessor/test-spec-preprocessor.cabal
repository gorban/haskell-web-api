cabal-version: 3.14
name: test-spec-preprocessor
version: 0.1.2.0
synopsis: Header preprocessor for Hspec test specifications
description: A dependency-light GHC preprocessor that supplies the conventional module and test prelude for SPEC test files.
homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
license-file: LICENSE
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Web
build-type: Simple

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed-modules: TestSpecPreprocessor
  hs-source-dirs: src
  build-depends:
    base ^>=4.22.0.0,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    mtl ^>=2.3.1,

executable spec-preprocessor
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base ^>=4.22.0.0,
    mtl ^>=2.3.1,
    test-spec-preprocessor ^>=0.1.2.0,
