cabal-version: 3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.
-- Initial package description 'haskell-web-api' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name: haskell-web-api
-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version: 0.1.2.0
-- A short (one-line) description of the package.
synopsis: haskell web api
-- A longer description of the package.
-- description:
-- URL for the project homepage or repository.
homepage: https://github.com/gorban/haskell-web-api
-- The license under which the package is released.
license: BSD-2-Clause-Patent
license-file: LICENSE
-- The package author(s).
author: David Bruck
-- An email address to which users can send suggestions, bug reports, and patches.
maintainer: 1393236+gorban@users.noreply.github.com
-- A copyright notice.
copyright: (c) David Bruck
category: Web
build-type: Hooks
-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files: CHANGELOG.md

custom-setup
  setup-depends:
    base ^>=4.22.0.0,
    Cabal ^>=3.16.0.0,
    Cabal-hooks ==3.16.*,
    Cabal-syntax ^>=3.16.0.0,
    core ^>=0.1.2.0,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    process ^>=1.6.26.1,

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:
common common
  -- Common warning flags.
  ghc-options: -Wall
  -- Common settings.
  default-language: GHC2024

library
  import: common
  -- Common library settings.
  exposed: True
  -- Modules included in this library.
  exposed-modules:
    WebApi
    WebApi.Account
    WebApi.AccountPages
    WebApi.AccountPages.Actions
    WebApi.AccountPages.Actions.Common
    WebApi.AccountPages.Actions.Contract
    WebApi.AccountPages.Actions.Workflows
    WebApi.AccountPages.Forms
    WebApi.AccountPages.Rendering
    WebApi.Api.Endpoints
    WebApi.App
    WebApi.App.Enhancements
    WebApi.App.Shell
    WebApi.AppEffect
    WebApi.Config
    WebApi.Database
    WebApi.DatabaseSetup
    WebApi.Login
    WebApi.Mfa
    WebApi.MfaEnrollment
    WebApi.Page
    WebApi.PageShell
    WebApi.Postgres
    WebApi.Postgres.Testing
    WebApi.Profile
    WebApi.Response
    WebApi.Route
    WebApi.RouteData
    WebApi.Session
    WebApi.SetupConfig
    WebApi.SetupPlan

  other-modules:
    WebApi.Config.Defaults
    WebApi.Config.Internal
    WebApi.Config.Loading
    WebApi.Config.Types
    WebApi.Page.Building
    WebApi.Page.Model
    WebApi.Page.Rendering
    WebApi.Postgres.AccountRepository
    WebApi.Postgres.LoginAttemptRepository
    WebApi.Postgres.MfaEnrollmentSessionRepository
    WebApi.Postgres.MfaRepository
    WebApi.Postgres.Migration
    WebApi.Postgres.PageRepository
    WebApi.Postgres.QueryRunner
    WebApi.Postgres.Runtime
    WebApi.Postgres.SessionRepository

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    aeson ^>=2.3.1.0,
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    core ^>=0.1.2.0,
    cryptonite ^>=0.30,
    directory ^>=1.3.10.0,
    harch-web ^>=0.1.2.0,
    http-types ^>=0.12.5,
    mtl ^>=2.3.1,
    postgresql-libpq ^>=0.11.0.0,
    process ^>=1.6.26.1,
    stm ^>=2.5.3.1,
    text ^>=2.1.3,
    time ^>=1.15,
    transformers ^>=0.6.1.2,
    wai ^>=3.2.5,

  -- Directories containing source files.
  hs-source-dirs: src

executable haskell-web-api
  import: common
  -- .hs or .lhs file containing the Main module.
  main-is: Main.hs
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts=-N

  -- Modules included in this executable, other than Main.
  -- other-modules:
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    base ^>=4.22.0.0,
    haskell-web-api ^>=0.1.2.0,

  -- Directories containing source files.
  hs-source-dirs: app

executable haskell-web-api-db
  import: common
  main-is: DatabaseSetupMain.hs
  build-depends:
    base ^>=4.22.0.0,
    haskell-web-api ^>=0.1.2.0,

  hs-source-dirs: app

test-suite haskell-web-api-tests
  import: common
  -- Common test suite settings.
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  -- Suppress warnings about missing home modules in test suite;
  -- Otherwise, we'd have to list all test modules in other-modules.
  -- Add -keep-tmp-files to the end to keep the generated files for inspection.
  -- E.g. in %LOCALAPPDATA%\Temp
  -- Search "name:ghc_tmp* extension:hspp"
  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -Wno-missing-home-modules
    -rtsopts
    -threaded
    -with-rtsopts=-N
    -- ESSENTIAL: This makes the executable available to tests

  build-tool-depends:
    -- Discovers hspec *Spec.hs tests
    -- Our spec-preprocessor to fill in {-# SPEC #-} headers
    haskell-web-api:haskell-web-api ^>=0.1.2.0,
    haskell-web-api:haskell-web-api-db ^>=0.1.2.0,
    hspec-discover:hspec-discover ^>=2.11.17,
    test-core:spec-preprocessor ^>=0.1.2.0,

  -- .hs or .lhs file containing the Main module.
  main-is: Main.hs
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Other library packages from which modules are imported.
  build-depends:
    -- For testing framework:
    -- For running the executable in tests:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    core ^>=0.1.2.0,
    cryptonite ^>=0.30,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    harch-web ^>=0.1.2.0,
    haskell-web-api ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    network ^>=3.2.8.0,
    postgresql-libpq ^>=0.11.0.0,
    process ^>=1.6.26.1,
    template-haskell ^>=2.24.0.0,
    temporary ^>=1.3,
    test-core ^>=0.1.2.0,
    text ^>=2.1.3,
    wai ^>=3.2.5,
