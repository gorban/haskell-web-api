cabal-version: 3.14
name: custom-api
version: 0.1.0.0
synopsis: Declarative API endpoint table using HarchWeb route families
description:
  Buildable example of a typed API endpoint table composed through a closed HarchWeb route family.

homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Web
build-type: Simple
extra-doc-files: README.md

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed-modules: App.Api.Declarative
  hs-source-dirs: src
  build-depends:
    aeson ^>=2.3.1.0,
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    harch-web ^>=0.1.2.0,
    text ^>=2.1.3,
    wai ^>=3.2.5,

test-suite custom-api-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -rtsopts
    -threaded

  build-depends:
    aeson ^>=2.3.1.0,
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    custom-api ^>=0.1.0.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    text ^>=2.1.3,
    wai ^>=3.2.5,
