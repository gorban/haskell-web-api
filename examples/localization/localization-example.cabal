cabal-version: 3.14
name: localization-example
version: 0.1.0.0
synopsis: ICU localization catalog and adapter example for HarchWeb
description: Buildable example with English, Spanish, and Icelandic HTML and API messages.
homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Web
build-type: Simple
extra-doc-files: README.md

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed-modules: App.Localization
  hs-source-dirs: src
  build-depends:
    base ^>=4.22.0.0,
    harch-web ^>=0.1.2.0,
    text ^>=2.1.3,

test-suite localization-example-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -rtsopts
    -threaded

  build-depends:
    base ^>=4.22.0.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    localization-example ^>=0.1.0.0,
