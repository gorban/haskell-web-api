cabal-version: 3.14
name: two-pages-example
version: 0.1.0.0
synopsis: Minimal two-page HarchWeb example
description:
  Buildable SSR-first example with two pages, a shared shell, and tiny
  same-origin navigation enhancement.

homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
license-file: LICENSE
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
copyright: (c) David Bruck
category: Web
build-type: Hooks
extra-doc-files:
  README.md

extra-source-files:
  src/App/Pages/**/*.hs
  src/App/Pages/*.hs

custom-setup
  setup-depends:
    base ^>=4.22.0.0,
    Cabal-hooks ==3.16.*,
    core ^>=0.1.2.0,
    directory ^>=1.3.10.0,
    filepath ^>=1.5.4.0,
    transformers ^>=0.6.1.2,

common common
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wpartial-fields -Wredundant-constraints -Wunused-packages
  default-language: GHC2024

library
  import: common
  ghc-options: -Wno-missing-home-modules
  exposed-modules:
    App.App
    App.Components.Controls
    App.Components.ExampleAuthor
    App.Components.Layout
    App.Components.SubscriptionEmailField
    App.CustomPages.Preview
    App.Pages.Generated
    App.Pages.Home
    App.Pages.LiveData
    App.Pages.NotFound
    App.Pages.Route.Generated
    App.Pages.Second
    App.Routes

  autogen-modules:
    App.Pages.Generated
    App.Pages.Route.Generated

  hs-source-dirs: src
  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    harch-web ^>=0.1.2.0,
    http-types ^>=0.12.5,
    text ^>=2.1.3,
    wai ^>=3.2.5,

executable two-pages-example
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-depends:
    base ^>=4.22.0.0,
    harch-web ^>=0.1.2.0,
    two-pages-example ^>=0.1.0.0,

test-suite two-pages-example-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -Wno-missing-home-modules
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    test-core ^>=0.1.2.0,
    text ^>=2.1.3,
    two-pages-example ^>=0.1.0.0,
    wai ^>=3.2.5,

  build-tool-depends:
    test-spec-preprocessor:spec-preprocessor ^>=0.1.2.0
