cabal-version: 3.14
name: composed-domains
version: 0.1.0.0
synopsis: Composition root for the Catalog and Orders domain examples
description: A runnable typed application composition example that mounts independent Catalog and Orders packages below a locale-aware root.
homepage: https://github.com/gorban/haskell-web-api
license: BSD-2-Clause-Patent
author: David Bruck
maintainer: 1393236+gorban@users.noreply.github.com
category: Web
build-type: Simple

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

  default-language: GHC2024

library
  import: common
  exposed-modules: App.Composed
  other-modules:
    App.Composed.Localized
    App.Composed.Model
    App.Composed.Mounts
    App.Composed.Public

  hs-source-dirs: src
  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    catalog-domain ^>=0.1.0.0,
    harch-web ^>=0.1.2.0,
    http-types ^>=0.12.5,
    orders-domain ^>=0.1.0.0,
    text ^>=2.1.3,
    wai ^>=3.2.5,

executable composed-domains
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base ^>=4.22.0.0,
    catalog-domain ^>=0.1.0.0,
    composed-domains ^>=0.1.0.0,
    harch-web ^>=0.1.2.0,
    orders-domain ^>=0.1.0.0,

test-suite composed-domains-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-tool-depends:
    test-spec-preprocessor:spec-preprocessor ^>=0.1.2.0

  other-modules:
    E2E.ComposedSpec
    Unit.App.ComposedSpec

  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    catalog-domain ^>=0.1.0.0,
    composed-domains ^>=0.1.0.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    orders-domain ^>=0.1.0.0,
    test-core ^>=0.1.2.0,
    text ^>=2.1.3,
    wai ^>=3.2.5,
