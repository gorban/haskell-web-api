# Intended as a ./.env.local body layered on top of the committed defaults.
# Smallest local loopback HTTP-only runtime shape.

APP_TITLE_PREFIX=web-api-local-http

LISTENER_0_HOST=127.0.0.1
LISTENER_0_PORT=5001
LISTENER_0_SCHEME=http

# Response hardening headers are enabled by default, while CORS remains same-origin
# unless CORS_ALLOWED_ORIGINS is explicitly set.

# Static assets default to an extension allowlist for .css, .html, .js, .json, .svg, and .txt.
# Uncomment both lines to opt into extensionless files as application/octet-stream.
# STATIC_ASSET_CONTENT_TYPE_1_EXTENSION=
# STATIC_ASSET_CONTENT_TYPE_1_MIME_TYPE=application/octet-stream
