# Intended as a ./.env.local body layered on top of the committed defaults.
# Backend HTTP listener for a TLS-terminating reverse proxy or load balancer.
# The proxy must forward X-Forwarded-Proto=https (and X-Forwarded-Prefix when
# mounted below a path prefix) so redirects, links, and HSTS behave correctly.

APP_TITLE_PREFIX=web-api-tls-offload

LISTENER_0_HOST=0.0.0.0
LISTENER_0_PORT=5001
LISTENER_0_SCHEME=http

REDIRECT_HTTP_TO_HTTPS=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
