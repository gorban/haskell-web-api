# Intended as a ./.env.local body layered on top of the committed defaults.
# Supplying OTLP_TRACING_ENDPOINT implicitly enables tracing unless an explicit
# opt-out disables it.

APP_TITLE_PREFIX=web-api-implicit-otlp

OTLP_TRACING_ENDPOINT=http://collector:4318/v1/traces
OTLP_TRACING_HEADERS=authorization=Bearer replace-me
