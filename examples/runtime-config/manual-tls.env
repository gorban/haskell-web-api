# Intended as a ./.env.local body layered on top of the committed defaults.
# Local manual TLS example. The reverse-proxy helper can generate matching
# loopback cert files under examples/reverse-proxy/tls/.

APP_TITLE_PREFIX=web-api-manual-tls

LISTENER_0_HOST=127.0.0.1
LISTENER_0_PORT=5443
LISTENER_0_SCHEME=https
LISTENER_0_TLS_SOURCE=manual
LISTENER_0_TLS_CERTIFICATE_FILE=./examples/reverse-proxy/tls/fullchain.pem
LISTENER_0_TLS_PRIVATE_KEY_FILE=./examples/reverse-proxy/tls/privkey.pem
