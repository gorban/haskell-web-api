# Intended as a ./.env.local body layered on top of the committed defaults.
# Shared TLS fail-fast example. This expects fullchain.pem and privkey.pem to
# already exist in the configured directory before startup begins.

APP_TITLE_PREFIX=web-api-shared-fail-fast

LISTENER_0_HOST=127.0.0.1
LISTENER_0_PORT=5443
LISTENER_0_SCHEME=https
LISTENER_0_TLS_SOURCE=shared-fail-fast
LISTENER_0_TLS_CERTIFICATE_DIRECTORY=./examples/reverse-proxy/tls
