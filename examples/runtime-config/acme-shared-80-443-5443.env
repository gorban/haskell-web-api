# Intended as a ./.env.local body layered on top of the committed defaults.
# ACME http-01 on port 80, the ACME-managed HTTPS listener on 443, and a second
# shared-certificate HTTPS listener on 5443. Replace the example domains and
# contact email before use. The shared certificate directory must stay writable
# and visible to both HTTPS listeners.

APP_TITLE_PREFIX=web-api-acme-shared

LISTENER_0_HOST=0.0.0.0
LISTENER_0_PORT=80
LISTENER_0_SCHEME=http

LISTENER_1_HOST=0.0.0.0
LISTENER_1_PORT=443
LISTENER_1_SCHEME=https
LISTENER_1_TLS_SOURCE=acme
LISTENER_1_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
LISTENER_1_ACME_CONTACT_EMAILS=ops@example.com
LISTENER_1_ACME_DOMAINS=example.com,www.example.com
LISTENER_1_ACME_CERTIFICATE_DIRECTORY=/tmp/web-api-acme/example.com
LISTENER_1_ACME_CHALLENGE_BACKEND=certbot-http01
LISTENER_1_ACME_CERTBOT_ARGUMENTS=certonly,--non-interactive,--agree-tos,--email,ops@example.com,--staging,--http-01-port,80

LISTENER_2_HOST=0.0.0.0
LISTENER_2_PORT=5443
LISTENER_2_SCHEME=https
LISTENER_2_TLS_SOURCE=shared
LISTENER_2_TLS_CERTIFICATE_DIRECTORY=/tmp/web-api-acme/example.com
