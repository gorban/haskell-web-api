# Intended as a ./.env.local body layered on top of the committed defaults.
# ACME http-01 on port 80, plus shared-certificate HTTPS listeners on 443 and
# 5443. Replace the example domains and
# contact email before use. When no explicit certificate-directory overrides are
# set, ACME publishes into ./.tls/<cert-name> and the shared listener reuses it.

APP_TITLE_PREFIX=web-api-acme-shared

LISTENER_0_HOST=0.0.0.0
LISTENER_0_PORT=80
LISTENER_0_SCHEME=http
# Omit this line to use the production Let's Encrypt directory; keep it explicit
# here because this example intentionally targets staging.
LISTENER_0_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
LISTENER_0_ACME_CONTACT_EMAILS=ops@example.com
LISTENER_0_ACME_DOMAINS=example.com,www.example.com

LISTENER_1_HOST=0.0.0.0
LISTENER_1_PORT=443
LISTENER_1_SCHEME=https
LISTENER_1_TLS_SOURCE=shared-wait
LISTENER_1_TLS_SHARED_WAIT_SECONDS=120

LISTENER_2_HOST=0.0.0.0
LISTENER_2_PORT=5443
LISTENER_2_SCHEME=https
LISTENER_2_TLS_SOURCE=shared-wait
LISTENER_2_TLS_SHARED_WAIT_SECONDS=120
