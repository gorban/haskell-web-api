cabal-version: 3.14
name: multipart-upload-example
version: 0.1.0.0
synopsis: A CSRF-protected bounded multipart upload example for HarchWeb.Api
license: BSD-2-Clause-Patent
build-type: Simple
extra-doc-files: README.md

common common
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wpartial-fields -Wredundant-constraints -Wunused-packages
  default-language: GHC2024

library
  import: common
  exposed-modules:
    App.App
    App.MultipartUpload
  hs-source-dirs: src
  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    harch-web ^>=0.1.2.0,
    http-types ^>=0.12.5,
    text ^>=2.1.3,
    wai ^>=3.2.5,

executable multipart-upload-example
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts=-N

  build-depends:
    base ^>=4.22.0.0,
    multipart-upload-example ^>=0.1.0.0,
    warp ^>=3.4.12,

test-suite multipart-upload-example-tests
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -F
    -pgmF=spec-preprocessor
    -Wno-missing-home-modules
    -rtsopts
    -threaded
    -with-rtsopts=-N
  build-depends:
    base ^>=4.22.0.0,
    bytestring ^>=0.12.2.0,
    harch-web ^>=0.1.2.0,
    hspec ^>=2.11.17,
    http-types ^>=0.12.5,
    multipart-upload-example ^>=0.1.0.0,
    test-core ^>=0.1.2.0,
    text ^>=2.1.3,
    wai ^>=3.2.5,
  build-tool-depends:
    test-core:spec-preprocessor ^>=0.1.2.0
