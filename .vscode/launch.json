{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "haskell-debugger",
            "request": "launch",
            "name": "debug current file",
            "projectRoot": "${workspaceFolder}",
            "entryFile": "${file}",
            "entryPoint": "main",
            "entryArgs": [],
            "extraGhcArgs": []
        },
        {
            "type": "haskell-debugger",
            "request": "launch",
            "name": "debug test suite",
            "projectRoot": "${workspaceFolder}",
            "entryFile": "packages/${input:haskellTestPackage}/test/Main.hs",
            "entryPoint": "main",
            "entryArgs": [],
            "extraGhcArgs": []
        },
        {
            "type": "haskell-debugger",
            "request": "launch",
            "name": "debug filtered test suite",
            "projectRoot": "${workspaceFolder}",
            "entryFile": "packages/${input:haskellTestPackage}/test/Main.hs",
            "entryPoint": "main",
            "entryArgs": [
                "--match",
                "${input:haskellSpecFilter}"
            ],
            "extraGhcArgs": []
        },
        {
            "type": "haskell-debugger",
            "request": "launch",
            "name": "debug current folder in test suite",
            "projectRoot": "${workspaceFolder}",
            "entryFile": "packages/${input:haskellTestPackage}/test/Main.hs",
            "entryPoint": "main",
            "entryArgs": [
                "--match",
                "${fileDirnameBasename}"
            ],
            "extraGhcArgs": []
        }
    ],
    "inputs": [
        {
            "id": "haskellTestPackage",
            "type": "pickString",
            "description": "Select the test package to debug",
            "options": [
                "core",
                "harch-web",
                "hspec-expectations-match",
                "test-core",
                "web-api"
            ],
            "default": "web-api"
        },
        {
            "id": "haskellSpecFilter",
            "type": "promptString",
            "description": "Hspec --match filter, for example Unit, Integration, or Unit.TestCore.CustomAssertions",
            "default": "Unit"
        }
    ]
}
